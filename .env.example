# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) — not used for sending; kept for the SY35 connectivity check
RESEND_API_KEY=

# Payments (Mollie)
MOLLIE_API_KEY=

# Document tokens
DOCUMENT_TOKEN_SECRET=

# AI (optional, for BW50)
ANTHROPIC_API_KEY=

# IMAP (Zoho Mail inbound email polling)
IMAP_HOST=imappro.zoho.eu
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECRET=

# Outbound email (Zoho SMTP via nodemailer; falls back to IMAP_USER/IMAP_PASS)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Colourking <info@colourking.nl>
EMAIL_REPLY_TO=info@colourking.nl
# Per-process sender addresses (offer@, invoice@, planning@, customer@) are set in SY01 > E-mail
# and must be "send as" aliases of SMTP_USER in Zoho.

# Cron (Vercel cron sends Authorization: Bearer CRON_SECRET; required — routes fail closed without it)
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://colourking.nl
